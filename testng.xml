<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">
<suite name="SauceDemo Test Suite" verbose="2">

    <listeners>
        <listener class-name="Listeners.Listeners"/>
    </listeners>

    <!--
        Change env to "staging" to run the entire suite against www.stg-saucedemo.com
        Or override from command line: mvn test -Denv=staging
    -->
    <parameter name="env" value="qa"/>

    <test name="Authentication Tests" preserve-order="true">
        <classes>
            <class name="authenticationTests.AuthenticationTest">
                <methods>
                    <include name="validLoginTest"/>
                    <include name="invalidLoginTest"/>
                </methods>
            </class>
        </classes>
    </test>

    <test name="Add To Cart Tests" preserve-order="true">
        <classes>
            <class name="addToCartTests.AddToCartTests">
                <methods>
                    <include name="addRandomProductToCart"/>
                </methods>
            </class>
        </classes>
    </test>

</suite>
